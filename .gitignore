# Firmware bytes are NOT committed by default -- they are regenerated by
# tools/extract_firmware.py from the corpus ELF. ONLY if your firmware is
# redistributable (document its licences in PROVENANCE.md, as device-plc does)
# should you un-ignore *.bin/*.elf below and ship them as package data.
*.bin
*.elf
*.out

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# run artifacts.  HALucinator writes tmp/HALucinator/stats.yaml into the cwd
# it is spawned from, which is the packaged configs dir.
*.log
tmp/
src/rehostry_bdn9/configs/tmp/

.DS_Store
